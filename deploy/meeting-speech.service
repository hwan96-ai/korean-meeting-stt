[Unit]
Description=Meeting notes server speech processing
After=network-online.target meeting-notes.service
Wants=network-online.target
Requires=meeting-notes.service

[Service]
Type=simple
User=meeting-speech
Group=meeting-speech
WorkingDirectory=/opt/meeting-speech/current
Environment=HOME=/var/lib/meeting-speech
Environment=MEETING_WORKER_HOME=/var/lib/meeting-speech
Environment=MEETING_WORKER_MODE=server
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
LoadCredential=worker.json:/etc/meeting-speech/worker.json
ExecStartPre=/opt/meeting-speech/venv/bin/python -m local_worker.server --doctor
ExecStart=/opt/meeting-speech/venv/bin/python -m local_worker.server
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meeting-speech
RestrictSUIDSGID=true
LockPersonality=true
CPUQuota=150%
MemoryMax=3G
Nice=15
TasksMax=96

[Install]
WantedBy=multi-user.target
